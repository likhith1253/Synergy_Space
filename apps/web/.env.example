# All five NEXT_PUBLIC_* URLs are required: `next build` / `next start` in
# production fail fast if any is missing (see next.config.ts).
# Defaults below assume every service runs locally on its default port.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_DOCUMENT_URL=http://localhost:3002
NEXT_PUBLIC_COLLAB_URL=http://localhost:3003
NEXT_PUBLIC_AI_URL=http://localhost:8001

# Server-side proxy targets used by the Next.js rewrites
BACKEND_API_URL=http://localhost:8000
BACKEND_AUTH_URL=http://localhost:3001

# Optional product-experience flags (default to true when unset)
ENABLE_DEMO_MODE=true
ENABLE_GUIDED_ONBOARDING=true
ENABLE_PRODUCT_TOUR=true
